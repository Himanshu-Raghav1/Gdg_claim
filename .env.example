# Cloudinary credentials (required for the Server Action to fetch photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# The Instagram handle displayed in the follow prompt
NEXT_PUBLIC_INSTAGRAM_HANDLE=gdgmitwpu

# The name of the Cloudinary folder where the main kiosk uploads photos
# Must match the folder used in the kiosk's uploadPolaroid.ts
NEXT_PUBLIC_CLOUDINARY_FOLDER=gdg-akinator-polaroids
